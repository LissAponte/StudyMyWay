@page "/"
@inject NavigationManager Nav
@inject StudyMyWay.Components.Pages.Service.BrowserService BrowserService;
@rendermode InteractiveServer
@using System.Threading.Tasks;

<PageTitle>Homepage</PageTitle>

<main>

    <header class="title">

        <h3>Homepage</h3>

    </header>

    
        <ul>
            <li>

                <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/study-room-dashboard")'>Study Rooms</button>
            </li>
            <li>
               <button class="btn btn-primary" @onclick='OpenExternalPopUp'>Browser</button> 
            </li>
            <li><button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/note-dashboard")'>Notes</button></li>

            <li><button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/progress-tracker-dashboard")'>Progress Tracker</button></li>
            <li><button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/timer-dashboard")'>Timers</button></li>

        </ul>





    <container>
        <p>No study rooms have been created yet</p>
    </container>

</main>

@code {
    private async Task OpenExternalPopUp()
    {
        const string features = "noopener,noreferrer,width=900,height=700";
        await BrowserService.Open("https://www.google.com","_blank", features);
    }
}

